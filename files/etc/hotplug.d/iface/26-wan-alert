#!/usr/bin/ucode
'use strict';

import { cursor } from 'uci';

let action = getenv('ACTION');
let iface = getenv('INTERFACE');
if (action != 'ifup' && action != 'ifdown')
	exit(0);
if (iface == null || iface == '' || iface == 'loopback' || iface == 'lan' || iface == 'wan6' || match(iface, /_6$/))
	exit(0);

let ctx = cursor();
ctx.load('mwan3');
let enabled = null;
ctx.foreach('mwan3', 'interface', (s) => {
	if (s['.name'] == iface)
		enabled = s.enabled;
});
if (enabled == null)
	exit(0);
if (enabled == '0' || enabled == 0 || enabled == 'off')
	exit(0);

let ev = (action == 'ifdown') ? 'down' : 'up';
system(sprintf("/usr/libexec/wan-alert %s '%s' >/dev/null 2>&1 &", ev, replace(`${iface}`, /'/g, '')));
exit(0);
