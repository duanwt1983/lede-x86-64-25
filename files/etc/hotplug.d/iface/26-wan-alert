#!/bin/sh
# WAN up/down -> DingTalk custom robot.

case "${ACTION-}" in
	ifup|ifdown) ;;
	*) exit 0 ;;
esac

case "${INTERFACE-}" in
	loopback|lan|wan6|*_6) exit 0 ;;
esac

[ -f /etc/config/mwan3 ] || exit 0
uci -q get "mwan3.${INTERFACE}" >/dev/null || exit 0
[ "$(uci -q get mwan3.${INTERFACE}.enabled)" = 0 ] && exit 0

[ -x /usr/sbin/wan-alert ] || exit 0
[ "$(uci -q get wanalert.main.enabled)" = 1 ] || exit 0

case "$ACTION" in
	ifdown) /usr/sbin/wan-alert down "$INTERFACE" >/dev/null 2>&1 & ;;
	ifup)   /usr/sbin/wan-alert up "$INTERFACE" >/dev/null 2>&1 & ;;
esac
exit 0
