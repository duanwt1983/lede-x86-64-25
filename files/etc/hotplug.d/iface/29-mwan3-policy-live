#!/bin/sh
# When any mwan3 member is down, this nft build often leaves
# policy_<name> as only last_resort unreachable (0x3e00). LAN dies;
# DNS to the router still works. Rebuild the policy from *currently
# up* mwan3 IPv4 ifaces (any count, any names).

[ -f /lib/functions.sh ] || exit 0
. /lib/functions.sh

if [ -n "$ACTION" ]; then
	case "$ACTION" in
		ifup|ifdown|ifupdate) ;;
		*) exit 0 ;;
	esac
	[ -n "$INTERFACE" ] || exit 0
	[ "$(uci -q get "mwan3.${INTERFACE}")" = "interface" ] || exit 0
fi

LOCK=/var/run/mwan3-policy-live.lock
exec 7>"$LOCK"
flock 7

N=0
LIVE_MARKS=""
LIVE_N=0
HAVE_DEAD=0
DEAD_TABLES=""

_up() {
	ubus call "network.interface.$1" status 2>/dev/null | jsonfilter -e '@.up' 2>/dev/null
}

scan_one() {
	local iface="$1"
	local enabled family up table mark

	config_get_bool enabled "$iface" enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get family "$iface" family ipv4
	[ "$family" = ipv4 ] || return 0

	N=$((N + 1))
	table="$N"
	mark=$((table << 8))
	up="$(_up "$iface")"

	if [ "$up" = "true" ]; then
		LIVE_MARKS="$LIVE_MARKS $mark"
		LIVE_N=$((LIVE_N + 1))
	else
		HAVE_DEAD=1
		DEAD_TABLES="$DEAD_TABLES $table"
	fi
}

set_policy_from_live() {
	local pol chain i mark last

	pol="$(uci -q get mwan3.default.use_policy)"
	[ -n "$pol" ] || pol="balanced"
	chain="mwan3_policy_${pol}"

	nft flush chain inet mwan3 "$chain" 2>/dev/null || true
	[ "$LIVE_N" -gt 0 ] || return 0

	last=""
	for mark in $LIVE_MARKS; do
		last="$mark"
	done

	i=0
	for mark in $LIVE_MARKS; do
		if [ "$mark" = "$last" ]; then
			nft -f - <<EOF
add rule inet mwan3 $chain meta mark & 0x00003f00 == 0x00000000 meta mark set meta mark & 0xffffc0ff | $mark
EOF
		else
			nft -f - <<EOF
add rule inet mwan3 $chain meta mark & 0x00003f00 == 0x00000000 numgen random mod $LIVE_N == $i meta mark set meta mark & 0xffffc0ff | $mark
EOF
		fi
		i=$((i + 1))
	done
}

config_load mwan3
config_foreach scan_one interface

if [ "$HAVE_DEAD" = 1 ] && [ "$LIVE_N" -gt 0 ]; then
	set_policy_from_live
	for table in $DEAD_TABLES; do
		nft flush set inet mwan3 "mwan3_sticky_v4_default_${table}" 2>/dev/null || true
	done
	logger -t mwan3-policy-live "dead tables${DEAD_TABLES}; live marks${LIVE_MARKS} (n=$LIVE_N)"
fi

if [ "$ACTION" = "ifdown" ]; then
	( sleep 3; ACTION= /bin/sh /etc/hotplug.d/iface/29-mwan3-policy-live ) >/dev/null 2>&1 &
	( sleep 10; ACTION= /bin/sh /etc/hotplug.d/iface/29-mwan3-policy-live ) >/dev/null 2>&1 &
fi
