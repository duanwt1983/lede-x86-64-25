config wanalert 'main'
	option enabled '0'
	option dingtalk_webhook ''
	option security 'keyword'
	option keyword '线路'
	option dingtalk_secret ''
	option cooldown '120'
	option alert_down '1'
	option alert_up '1'
	option alert_all_down '1'
	option extra_text ''
	option log_enabled '1'
	option log_path '/overlay/sys-alert.log'
	option log_max_kb '512'
	option log_sample '1'
	option check_interval '60'
	option alert_dhcp '1'
	option dhcp_remain '8'
	option alert_cpu '1'
	option cpu_percent '90'
	option alert_load '1'
	option load_warn '2.00'
	option alert_mem '1'
	option mem_percent '90'
	option alert_disk '1'
	option disk_percent '90'
	list disk_path '/'
	list disk_path '/overlay'
	option alert_temp '1'
	option temp_c '80'
