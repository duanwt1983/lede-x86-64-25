#!/usr/bin/ucode
'use strict';

import { cursor } from 'uci';
import { readfile, popen } from 'fs';
import * as ubus from 'ubus';
import {
	trim, as_bool, now_fmt, max_temp_c, cpu_pct, bytes_of, disks_overview
} from '/usr/share/ucode/lede-metrics.uc';

function iface_status(u, name) {
	try {
		return u.call('network.interface.' + name, 'status') || {};
	} catch (e) {
		return {};
	}
}

function wan_health(name, up, ip, u) {
	let st = '';
	try {
		let mj = u.call('mwan3', 'status', { section: name });
		if (mj && mj.status)
			st = mj.status;
	} catch (e) {}
	if (st == 'online')
		return { health: 'ok', text: '正常' };
	if (st == 'offline')
		return { health: 'bad', text: '异常' };
	if (st == 'disabled')
		return { health: 'warn', text: '未启用' };
	if (st == 'notracking') {
		if (up && ip)
			return { health: 'ok', text: '正常' };
		if (up)
			return { health: 'warn', text: '无地址' };
		return { health: 'bad', text: '掉线' };
	}
	if (!up)
		return { health: 'bad', text: '掉线' };
	if (!ip)
		return { health: 'warn', text: '无地址' };
	return { health: 'ok', text: '正常' };
}

function wan_latency(u, name) {
	try {
		let mj = u.call('mwan3', 'status', { section: name });
		if (!mj)
			return '';
		if (mj.latency != null && mj.latency != '')
			return `${mj.latency}`;
		if (type(mj.track_ips) == 'array' && mj.track_ips[0] && mj.track_ips[0].latency != null)
			return `${mj.track_ips[0].latency}`;
		if (type(mj.track_ip) == 'array' && mj.track_ip[0] && mj.track_ip[0].latency != null)
			return `${mj.track_ip[0].latency}`;
	} catch (e) {}
	return '';
}

function mac_online(lan_dev) {
	let set = {};
	let p = popen(sprintf("ip -4 neigh show dev '%s' 2>/dev/null", replace(lan_dev, /'/g, '')), 'r');
	if (!p)
		return set;
	let text = p.read('all') || '';
	p.close();
	for (let line in split(text, '\n')) {
		if (!match(line, /lladdr/) || match(line, /FAILED/) || match(line, /INCOMPLETE/))
			continue;
		let f = split(trim(line), /[ \t]+/);
		for (let i = 0; i < length(f); i++) {
			if (f[i] == 'lladdr' && i + 1 < length(f))
				set[lc(f[i + 1])] = true;
		}
	}
	return set;
}

function lc(s) {
	s = `${s}`;
	let out = '';
	for (let i = 0; i < length(s); i++) {
		let c = substr(s, i, 1);
		let o = ord(c);
		if (o >= 65 && o <= 90)
			out += sprintf('%c', o + 32);
		else
			out += c;
	}
	return out;
}

function conn_by_proto() {
	let p = popen("awk '$3==\"tcp\"{t++} $3==\"udp\"{u++} $3==\"icmp\"||$3==\"icmpv6\"{i++} END{print t+0, u+0, i+0}' /proc/net/nf_conntrack 2>/dev/null", 'r');
	if (!p)
		return { tcp: 0, udp: 0, icmp: 0 };
	let f = split(trim(p.read('all') || ''), /[ \t]+/);
	p.close();
	return { tcp: +f[0], udp: +f[1], icmp: +f[2] };
}

function snapshot() {
	let ctx = cursor();
	ctx.load('mwan3');
	ctx.load('network');
	let u = ubus.connect();
	let names = [];
	ctx.foreach('mwan3', 'interface', (s) => {
		if (!as_bool(s.enabled, true))
			return;
		if (s.family != null && s.family != '' && s.family != 'ipv4')
			return;
		push(names, s['.name']);
	});
	if (length(names) == 0) {
		ctx.foreach('network', 'interface', (s) => {
			let sid = s['.name'];
			if (sid == 'loopback' || sid == 'lan' || sid == 'wan6' || match(sid, /_6$/))
				return;
			let proto = s.proto;
			if (proto == 'pppoe' || proto == 'dhcp' || proto == 'static' || proto == 'pptp' ||
			    proto == 'l2tp' || proto == '3g' || proto == 'ncm' || proto == 'qmi' || proto == 'modemmanager')
				push(names, sid);
		});
	}

	let wans = [];
	for (let name in names) {
		let st = iface_status(u, name);
		let dev = st.l3_device || ctx.get('network', name, 'device') || '';
		let ip = '';
		let a4 = st['ipv4-address'];
		if (type(a4) == 'array' && a4[0] && a4[0].address)
			ip = a4[0].address;
		let up = (st.up == true || st.up == 1);
		let b = bytes_of(dev);
		let h = wan_health(name, up, ip, u);
		push(wans, {
			name, device: dev, ipv4: ip,
			proto: ctx.get('network', name, 'proto') || '',
			ifuptime: +(st.uptime || 0),
			latency: wan_latency(u, name),
			up: up,
			health: h.health,
			health_text: h.text,
			rx_bytes: b.rx,
			tx_bytes: b.tx
		});
	}

	let lst = iface_status(u, 'lan');
	let lan_dev = lst.l3_device || 'br-lan';
	let lan_ip = '';
	let la4 = lst['ipv4-address'];
	if (type(la4) == 'array' && la4[0] && la4[0].address)
		lan_ip = la4[0].address;
	let lb = bytes_of(lan_dev);
	let online_set = mac_online(lan_dev);
	let online = 0;
	for (let _ in online_set)
		online++;

	let clients = [];
	let leases = 0;
	let now = time();
	for (let line in split(readfile('/tmp/dhcp.leases') || '', '\n')) {
		let f = split(trim(line), /[ \t]+/);
		if (length(f) < 2)
			continue;
		let exp = +f[0], mac = f[1], ip = f[2], host = f[3];
		if (mac == null || mac == '' || mac == '*')
			continue;
		if (exp != 0 && exp < now)
			continue;
		leases++;
		mac = lc(mac);
		let name = (host != null && host != '' && host != '*') ? host : ip;
		push(clients, {
			mac, ip: ip || '', name,
			online: online_set[mac] ? true : false
		});
	}

	let conn = +(trim(readfile('/proc/sys/net/netfilter/nf_conntrack_count') || '0'));
	let conn_max = +(trim(readfile('/proc/sys/net/netfilter/nf_conntrack_max') || '0'));
	let proto = conn_by_proto();
	let up = split(trim(readfile('/proc/uptime') || '0'), /[ \t]+/)[0];
	let clock = now_fmt();
	let clock_hms = '';
	let clock_day = '';
	let hm = match(clock, /^([0-9-]+) ([0-9:]+)$/);
	if (hm) {
		clock_day = hm[1];
		clock_hms = hm[2];
	}

	print(sprintf('%J\n', {
		ts: int(+up * 1000),
		wans,
		lan: { device: lan_dev, ipv4: lan_ip, rx_bytes: lb.rx, tx_bytes: lb.tx },
		clients,
		clients_sum: { online, leases },
		sys: {
			clock, clock_hms, clock_day,
			temp_c: max_temp_c(),
			cpu_pct: cpu_pct(),
			conn, conn_max,
			conn_tcp: proto.tcp,
			conn_udp: proto.udp,
			conn_icmp: proto.icmp
		},
		disks: disks_overview()
	}));
}

let cmd = ARGV[0];
if (cmd == 'list') {
	print('{ "snapshot": {} }\n');
} else if (cmd == 'call' && ARGV[1] == 'snapshot') {
	snapshot();
}
