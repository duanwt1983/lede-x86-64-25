#!/usr/bin/ucode
'use strict';

import { cursor } from 'uci';
import { readfile, writefile, popen } from 'fs';
import * as ubus from 'ubus';
import {
	trim, as_bool, as_list, now_fmt, max_temp_c, cpu_pct, bytes_of, disks_overview
} from '/usr/share/ucode/lede-metrics.uc';

function iface_status(u, name) {
	try {
		return u.call('network.interface.' + name, 'status') || {};
	} catch (e) {
		return {};
	}
}

function mwan3_ifaces(u) {
	try {
		let mj = u.call('mwan3', 'status');
		if (mj && type(mj.interfaces) == 'object')
			return mj.interfaces;
	} catch (e) {}
	return {};
}

function wan_health(name, up, ip, ifaces) {
	let d = ifaces[name];
	let st = d && d.status ? d.status : '';
	if (st == 'online')
		return { health: 'ok', text: '正常' };
	if (st == 'offline')
		return { health: 'bad', text: '异常' };
	if (st == 'disabled')
		return { health: 'warn', text: '未启用' };
	if (st == 'notracking') {
		if (up && ip)
			return { health: 'ok', text: '正常' };
		if (up)
			return { health: 'warn', text: '无地址' };
		return { health: 'bad', text: '掉线' };
	}
	if (!up)
		return { health: 'bad', text: '掉线' };
	if (!ip)
		return { health: 'warn', text: '无地址' };
	return { health: 'ok', text: '正常' };
}

function is_ipv4(s) {
	return match(`${s}`, /^[0-9]{1,3}(\.[0-9]{1,3}){3}$/) != null;
}

function ping_host_for(mw, ctx, name) {
	let d = mw[name];
	if (d && type(d.track_ip) == 'array') {
		for (let t in d.track_ip)
			if (t && t.status == 'up' && is_ipv4(t.ip))
				return t.ip;
		for (let t in d.track_ip)
			if (t && t.status != 'skipped' && is_ipv4(t.ip))
				return t.ip;
		for (let t in d.track_ip)
			if (t && is_ipv4(t.ip))
				return t.ip;
	}
	let list = ctx.get('mwan3', name, 'track_ip');
	if (type(list) == 'array') {
		for (let ip in list)
			if (is_ipv4(ip))
				return ip;
	} else if (is_ipv4(list))
		return list;
	return '223.5.5.5';
}

function lat_tag(name) {
	return replace(`${name}`, /[^A-Za-z0-9_]/g, '_');
}

function kick_wan_ping(name, dev, host) {
	if (!dev || match(dev, /[^A-Za-z0-9._-]/) || !is_ipv4(host))
		return;
	let tag = lat_tag(name);
	let stamp = '/tmp/lede-wan-lat-' + tag + '.t';
	let now = time();
	let last = +trim(readfile(stamp) || '0');
	if (last > 0 && now - last < 8)
		return;
	writefile(stamp, now + '\n');
	let out = '/tmp/lede-wan-lat-' + tag;
	system(sprintf("(ping -c 1 -W 1 -I %s %s 2>/dev/null | awk -F'time=' '/time=/{gsub(/ ms/,\"\"); print $2; exit}' > %s.tmp && mv %s.tmp %s) >/dev/null 2>&1 &",
		dev, host, out, out, out));
}

function wan_latency(mw, ctx, name, dev, up) {
	if (!up)
		return '';
	let host = ping_host_for(mw, ctx, name);
	kick_wan_ping(name, dev, host);
	let tag = lat_tag(name);
	let val = trim(readfile('/tmp/lede-wan-lat-' + tag) || '');
	if (match(val, /^[0-9]+(\.[0-9]+)?$/))
		return val;
	return '';
}

function sys_speed(dev) {
	if (!dev || match(dev, /[^A-Za-z0-9_.-]/))
		return 0;
	let n = +trim(readfile('/sys/class/net/' + dev + '/speed') || '');
	if (n > 0 && n < 200000)
		return int(n);
	return 0;
}

function walk_speed(dev, depth) {
	let n = sys_speed(dev);
	if (n)
		return n;
	if (depth > 3 || !dev || match(dev, /[^A-Za-z0-9_.-]/))
		return 0;

	let p = popen(sprintf('ls -1 /sys/class/net/%s/lower_* 2>/dev/null', dev), 'r');
	if (p) {
		let text = p.read('all') || '';
		p.close();
		for (let line in split(text, '\n')) {
			let bn = trim(line);
			if (!bn || index(bn, '*') >= 0)
				continue;
			let parts = split(bn, '/');
			bn = parts[length(parts) - 1];
			if (index(bn, 'lower_') == 0)
				bn = substr(bn, 6);
			n = walk_speed(bn, depth + 1);
			if (n)
				return n;
		}
	}

	p = popen(sprintf('ls /sys/class/net/%s/brif 2>/dev/null', dev), 'r');
	if (!p)
		return 0;
	let text = p.read('all') || '';
	p.close();
	for (let name in split(text, '\n')) {
		name = trim(name);
		if (!name)
			continue;
		n = walk_speed(name, depth + 1);
		if (n)
			return n;
	}
	return 0;
}

function link_mbps(dev) {
	return walk_speed(dev, 0);
}

function lan_pfx(ip) {
	let p = split(`${ip}`, '.');
	if (length(p) != 4)
		return '';
	return p[0] + '.' + p[1] + '.' + p[2] + '.';
}

function ensure_ct_acct() {
	let v = trim(readfile('/proc/sys/net/netfilter/nf_conntrack_acct') || '');
	if (v == '1')
		return;
	try {
		writefile('/proc/sys/net/netfilter/nf_conntrack_acct', '1\n');
	} catch (e) {}
}

function ct_client_bytes(lan_ip) {
	ensure_ct_acct();
	let pfx = lan_pfx(lan_ip);
	let map = {};
	if (!pfx)
		return map;
	let text = readfile('/proc/net/nf_conntrack') || '';
	for (let line in split(text, '\n')) {
		if (!line || index(line, 'src=') < 0)
			continue;
		let srcs = [];
		let bytes = [];
		for (let tok in split(trim(line), /[ \t]+/)) {
			if (index(tok, 'src=') == 0)
				push(srcs, substr(tok, 4));
			else if (index(tok, 'bytes=') == 0)
				push(bytes, +substr(tok, 6));
		}
		if (length(srcs) < 2 || length(bytes) < 2)
			continue;
		let o = srcs[0], r = srcs[1], ob = bytes[0] || 0, rb = bytes[1] || 0;
		let o_lan = (index(o, pfx) == 0 && o != lan_ip);
		let r_lan = (index(r, pfx) == 0 && r != lan_ip);
		let ip = '';
		let rx = 0, tx = 0;
		if (o_lan && !r_lan) {
			ip = o;
			tx = ob;
			rx = rb;
		} else if (r_lan && !o_lan) {
			ip = r;
			rx = ob;
			tx = rb;
		} else
			continue;
		if (!map[ip])
			map[ip] = { rx: 0, tx: 0, conns: 0 };
		map[ip].rx += rx;
		map[ip].tx += tx;
		map[ip].conns++;
	}
	return map;
}

function mac_online(lan_dev) {
	let set = {};
	let p = popen(sprintf("ip -4 neigh show dev '%s' 2>/dev/null", replace(lan_dev, /'/g, '')), 'r');
	if (!p)
		return set;
	let text = p.read('all') || '';
	p.close();
	for (let line in split(text, '\n')) {
		if (!match(line, /lladdr/) || match(line, /FAILED/) || match(line, /INCOMPLETE/))
			continue;
		let f = split(trim(line), /[ \t]+/);
		for (let i = 0; i < length(f); i++) {
			if (f[i] == 'lladdr' && i + 1 < length(f))
				set[lc(f[i + 1])] = true;
		}
	}
	return set;
}

function arp_macs() {
	let out = {};
	for (let line in split(readfile('/proc/net/arp') || '', '\n')) {
		let f = split(trim(line), /[ \t]+/);
		if (length(f) < 4 || f[0] == 'IP')
			continue;
		let mac = lc(f[3]);
		if (!match(mac, /^[0-9a-f]{2}(:[0-9a-f]{2}){5}$/) || mac == '00:00:00:00:00:00')
			continue;
		out[f[0]] = mac;
	}
	return out;
}

function dhcp_static_names(ctx) {
	let byMac = {}, byIp = {};
	try {
		ctx.foreach('dhcp', 'host', (s) => {
			let n = s.name || '';
			if (!n)
				return;
			if (s.mac)
				byMac[lc(s.mac)] = n;
			if (s.ip)
				byIp[s.ip] = n;
		});
	} catch (e) {}
	return { byMac, byIp };
}

function host_label(lease_host, mac, ip, staticn) {
	if (lease_host != null && lease_host != '' && lease_host != '*')
		return lease_host;
	if (mac && staticn.byMac[mac])
		return staticn.byMac[mac];
	if (ip && staticn.byIp[ip])
		return staticn.byIp[ip];
	return '';
}

function lc(s) {
	s = `${s}`;
	let out = '';
	for (let i = 0; i < length(s); i++) {
		let c = substr(s, i, 1);
		let o = ord(c);
		if (o >= 65 && o <= 90)
			out += sprintf('%c', o + 32);
		else
			out += c;
	}
	return out;
}

function conn_by_proto() {
	let p = popen("awk '$3==\"tcp\"{t++} $3==\"udp\"{u++} $3==\"icmp\"||$3==\"icmpv6\"{i++} END{print t+0, u+0, i+0}' /proc/net/nf_conntrack 2>/dev/null", 'r');
	if (!p)
		return { tcp: 0, udp: 0, icmp: 0 };
	let f = split(trim(p.read('all') || ''), /[ \t]+/);
	p.close();
	return { tcp: +f[0], udp: +f[1], icmp: +f[2] };
}

function skip_iface(sid) {
	if (sid == null || sid == '')
		return true;
	if (sid == 'loopback' || sid == 'lan' || sid == 'wan6')
		return true;
	if (match(sid, /_6$/) || match(sid, /^@/))
		return true;
	return false;
}

function wan_like_proto(proto) {
	return proto == 'pppoe' || proto == 'dhcp' || proto == 'pptp' || proto == 'l2tp' ||
		proto == 'pppoa' || proto == '3g' || proto == 'ncm' || proto == 'qmi' ||
		proto == 'modemmanager' || proto == 'mbim' || proto == 'wwan' ||
		proto == 'ppp' || proto == 'dslite' || proto == 'vti' || proto == 'gre';
}

function add_wan(names, seen, sid) {
	if (skip_iface(sid) || seen[sid])
		return;
	seen[sid] = true;
	push(names, sid);
}

/* Always from 网络 → 接口 / 防火墙 WAN 区。不依赖 mwan3 是否启用。 */
function collect_wan_names(ctx, u) {
	let names = [];
	let seen = {};

	ctx.foreach('firewall', 'zone', (z) => {
		if (z.name != 'wan')
			return;
		for (let n in as_list(z.network))
			add_wan(names, seen, n);
	});

	ctx.foreach('network', 'interface', (s) => {
		let sid = s['.name'];
		if (skip_iface(sid))
			return;
		if (match(sid, /^wan/) || wan_like_proto(s.proto))
			add_wan(names, seen, sid);
	});

	try {
		let dump = u.call('network.interface', 'dump');
		if (dump && type(dump.interface) == 'array') {
			for (let it in dump.interface) {
				let n = it.interface;
				if (skip_iface(n) || seen[n])
					continue;
				let routes = it.route;
				if (type(routes) != 'array')
					continue;
				for (let r in routes) {
					if (r && (r.target == '0.0.0.0' || r.target == '::')) {
						add_wan(names, seen, n);
						break;
					}
				}
			}
		}
	} catch (e) {}

	return names;
}

function snapshot() {
	let ctx = cursor();
	ctx.load('network');
	ctx.load('firewall');
	try { ctx.load('mwan3'); } catch (e) {}
	try { ctx.load('dhcp'); } catch (e) {}
	let u = ubus.connect();
	let names = collect_wan_names(ctx, u);
	let mw = mwan3_ifaces(u);

	let wans = [];
	for (let name in names) {
		let st = iface_status(u, name);
		let dev = st.l3_device || ctx.get('network', name, 'device') || '';
		let phy = st.device || ctx.get('network', name, 'device') || '';
		let ip = '';
		let a4 = st['ipv4-address'];
		if (type(a4) == 'array' && a4[0] && a4[0].address)
			ip = a4[0].address;
		let up = (st.up == true || st.up == 1);
		let b = bytes_of(dev);
		let h = wan_health(name, up, ip, mw);
		push(wans, {
			name, device: dev, ipv4: ip,
			proto: ctx.get('network', name, 'proto') || '',
			ifuptime: +(st.uptime || 0),
			latency: wan_latency(mw, ctx, name, dev, up),
			up: up,
			speed: link_mbps(dev) || link_mbps(phy),
			bw_down: +(ctx.get('network', name, 'lede_bw_down') || 0),
			bw_up: +(ctx.get('network', name, 'lede_bw_up') || 0),
			health: h.health,
			health_text: h.text,
			rx_bytes: b.rx,
			tx_bytes: b.tx
		});
	}

	let lst = iface_status(u, 'lan');
	let lan_dev = lst.l3_device || 'br-lan';
	let lan_ip = '';
	let la4 = lst['ipv4-address'];
	if (type(la4) == 'array' && la4[0] && la4[0].address)
		lan_ip = la4[0].address;
	let lb = bytes_of(lan_dev);
	let online_set = mac_online(lan_dev);
	let online = 0;
	for (let _ in online_set)
		online++;

	let ct = ct_client_bytes(lan_ip);
	let clients = [];
	let leases = 0;
	let now = time();
	let seen = {};
	let arp = arp_macs();
	let staticn = dhcp_static_names(ctx);
	for (let line in split(readfile('/tmp/dhcp.leases') || '', '\n')) {
		let f = split(trim(line), /[ \t]+/);
		if (length(f) < 2)
			continue;
		let exp = +f[0], mac = f[1], ip = f[2], host = f[3];
		if (mac == null || mac == '' || mac == '*')
			continue;
		if (exp != 0 && exp < now)
			continue;
		leases++;
		mac = lc(mac);
		if (ip && !arp[ip])
			arp[ip] = mac;
		let hostname = host_label(host, mac, ip, staticn);
		let acc = (ip && ct[ip]) ? ct[ip] : { rx: 0, tx: 0, conns: 0 };
		if (ip)
			seen[ip] = true;
		push(clients, {
			mac, ip: ip || '', hostname, name: hostname || ip,
			online: online_set[mac] ? true : false,
			rx_bytes: acc.rx, tx_bytes: acc.tx, conns: acc.conns
		});
	}
	for (let ip in ct) {
		if (seen[ip])
			continue;
		let mac = arp[ip] || '';
		let hostname = host_label('', mac, ip, staticn);
		push(clients, {
			mac, ip, hostname, name: hostname || ip,
			online: mac ? (online_set[mac] ? true : false) : true,
			rx_bytes: ct[ip].rx, tx_bytes: ct[ip].tx, conns: ct[ip].conns
		});
	}

	let conn = +(trim(readfile('/proc/sys/net/netfilter/nf_conntrack_count') || '0'));
	let conn_max = +(trim(readfile('/proc/sys/net/netfilter/nf_conntrack_max') || '0'));
	let proto = conn_by_proto();
	let up = split(trim(readfile('/proc/uptime') || '0'), /[ \t]+/)[0];
	let clock = now_fmt();
	let clock_hms = '';
	let clock_day = '';
	let hm = match(clock, /^([0-9-]+) ([0-9:]+)$/);
	if (hm) {
		clock_day = hm[1];
		clock_hms = hm[2];
	}

	print(sprintf('%J\n', {
		ts: int(+up * 1000),
		wans,
		lan: { device: lan_dev, ipv4: lan_ip, rx_bytes: lb.rx, tx_bytes: lb.tx, speed: link_mbps(lan_dev) },
		clients,
		clients_sum: { online, leases },
		sys: {
			clock, clock_hms, clock_day,
			temp_c: max_temp_c(),
			cpu_pct: cpu_pct(),
			conn, conn_max,
			conn_tcp: proto.tcp,
			conn_udp: proto.udp,
			conn_icmp: proto.icmp
		},
		disks: disks_overview()
	}));
}

let cmd = ARGV[0];
if (cmd == 'list') {
	print('{ "snapshot": {} }\n');
} else if (cmd == 'call' && ARGV[1] == 'snapshot') {
	snapshot();
}
