#!/usr/bin/ucode
'use strict';

import { cursor } from 'uci';
import { readfile, writefile, popen } from 'fs';
import * as ubus from 'ubus';
import {
	trim, as_bool, as_list, now_fmt, max_temp_c, cpu_pct, mem_percent, load1,
	disk_of, dhcp_pools
} from '/usr/share/ucode/lede-metrics.uc';
import { append_event } from '/usr/share/ucode/lede-log.uc';

const STATE = '/tmp/wan-alert.state';
const CONF = 'wanalert';
const DEFAULT_LOG = '/overlay/logs/sys-alert.log';

let ctx = cursor();
ctx.load(CONF);
ctx.load('mwan3');
ctx.load('dhcp');
ctx.load('network');
ctx.load('system');

function cfg(key, def) {
	let v = ctx.get(CONF, 'main', key);
	if (v == null || v == '')
		return def;
	return v;
}

function join_sp(arr) {
	let s = '';
	for (let i = 0; i < length(arr); i++) {
		if (i > 0)
			s += ' ';
		s += arr[i];
	}
	return s;
}

function hostname() {
	let host = 'LEDE';
	ctx.foreach('system', 'system', (s) => {
		if (s.hostname)
			host = s.hostname;
	});
	return host;
}

function urlencode(s) {
	s = `${s}`;
	let out = '';
	for (let i = 0; i < length(s); i++) {
		let ch = substr(s, i, 1);
		let o = ord(ch);
		if ((o >= 48 && o <= 57) || (o >= 65 && o <= 90) || (o >= 97 && o <= 122) ||
		    ch == '-' || ch == '_' || ch == '.' || ch == '~')
			out += ch;
		else
			out += sprintf('%%%02X', o);
	}
	return out;
}

function compose_text(body) {
	let kw = cfg('keyword', '线路');
	let extra = cfg('extra_text', '');
	if (cfg('security', 'keyword') != 'sign' && kw != '') {
		if (index(body, kw) < 0)
			body = kw + ' ' + body;
	}
	if (extra != '')
		body = body + ' ' + extra;
	return body;
}

function dingtalk_url() {
	let url = cfg('dingtalk_webhook', '');
	if (url == '')
		return null;
	let secret = cfg('dingtalk_secret', '');
	if (cfg('security', 'keyword') == 'sign' && secret != '') {
		let ts = sprintf('%d000', time());
		writefile('/tmp/wan-alert.hmac_key', secret);
		writefile('/tmp/wan-alert.hmac_msg', ts + '\n' + secret);
		let p = popen('openssl dgst -sha256 -hmac "$(cat /tmp/wan-alert.hmac_key)" -binary /tmp/wan-alert.hmac_msg | openssl base64 | tr -d "\n"', 'r');
		let sign = p ? trim(p.read('all')) : '';
		if (p)
			p.close();
		if (sign != '')
			return url + '&timestamp=' + ts + '&sign=' + urlencode(sign);
	}
	return url;
}

function send_dingtalk(text, force) {
	if (!force && !as_bool(cfg('enabled', '0'), false))
		return true;
	let url = dingtalk_url();
	if (!url)
		return false;
	text = compose_text(text);
	let mobiles = as_list(ctx.get(CONF, 'main', 'at_mobile'));
	let payload = { msgtype: 'text', text: { content: text } };
	if (length(mobiles) > 0)
		payload.at = { atMobiles: mobiles, isAtAll: false };
	writefile('/tmp/wan-alert.body', sprintf('%J', payload));
	if (system('command -v curl >/dev/null') == 0)
		system(sprintf("curl -sS -m 12 -H 'Content-Type: application/json; charset=utf-8' -d @/tmp/wan-alert.body '%s' > /tmp/wan-alert.last 2>&1", url));
	else
		system(sprintf("wget -q -O /tmp/wan-alert.last --timeout=12 --header='Content-Type: application/json' --post-data=\"$(cat /tmp/wan-alert.body)\" '%s'", url));
	let last = readfile('/tmp/wan-alert.last') || '';
	if (match(last, /"errcode"\s*:\s*0/))
		return true;
	print(last);
	return false;
}

function log_event(level, cat, title, detail) {
	if (!as_bool(cfg('log_enabled', '1'), true))
		return;
	let path = cfg('log_path', DEFAULT_LOG);
	append_event(path, cfg('log_max_kb', 512), level, cat, title, detail);
}

function load_state() {
	try {
		return json(readfile(STATE) || '{}') || {};
	} catch (e) {
		return {};
	}
}

function save_state(st) {
	writefile(STATE, sprintf('%J', st));
}

function cooled(key) {
	let cdn = +cfg('cooldown', 120);
	let st = load_state();
	let last = +st[key];
	if (!(last > 0))
		return false;
	return (time() - last) < cdn;
}

function stamp(key) {
	let st = load_state();
	st[key] = time();
	save_state(st);
}

function notify(level, cat, title, detail, key) {
	log_event(level, cat, title, detail);
	if (level == '信息')
		return true;
	if (key == null || key == '')
		key = 'misc';
	if (cooled(key))
		return true;
	stamp(key);
	return send_dingtalk(sprintf('[%s] %s：%s %s', hostname(), title, detail, now_fmt()));
}

function count_up_wans() {
	let u = ubus.connect();
	let n = 0;
	ctx.foreach('mwan3', 'interface', (s) => {
		if (!as_bool(s.enabled, true))
			return;
		try {
			let st = u.call('network.interface.' + s['.name'], 'status');
			if (st && st.up == true)
				n++;
		} catch (e) {}
	});
	return n;
}

function check_metrics() {
	let cpu = cpu_pct();
	let mem = mem_percent();
	let ld = load1();
	let tmp = max_temp_c();
	let pools = dhcp_pools(ctx);
	let dhcp_s = [];
	let warn_remain = +cfg('dhcp_remain', 8);
	for (let p in pools) {
		push(dhcp_s, sprintf('%s 已用%d/%d', p.name, p.used, p.limit));
		if (as_bool(cfg('alert_dhcp', '1'), true) && p.remain <= warn_remain)
			notify('中等', 'DHCP', '地址池不足',
				sprintf('%s 已用 %d/%d，剩余 %d（阈值：剩余≤%d）', p.name, p.used, p.limit, p.remain, warn_remain),
				'dhcp-' + p.name);
	}

	let cpu_l = +cfg('cpu_percent', 90);
	if (as_bool(cfg('alert_cpu', '1'), true) && cpu >= cpu_l)
		notify('中等', '资源', 'CPU 过高',
			sprintf('当前 %d%%，阈值 %d%%', cpu, cpu_l), 'cpu');

	let mem_l = +cfg('mem_percent', 90);
	if (as_bool(cfg('alert_mem', '1'), true) && mem >= mem_l)
		notify('中等', '资源', '内存不足',
			sprintf('当前已用 %d%%，阈值 %d%%', mem, mem_l), 'mem');

	let load_l = +cfg('load_warn', '2.00');
	if (as_bool(cfg('alert_load', '1'), true) && +ld >= load_l)
		notify('中等', '资源', '系统负载过高',
			sprintf('1 分钟负载 %s，阈值 %s', ld, cfg('load_warn', '2.00')), 'load');

	let disk_l = +cfg('disk_percent', 90);
	let paths = as_list(ctx.get(CONF, 'main', 'disk_path'));
	if (length(paths) == 0)
		paths = [ '/', '/overlay' ];
	let seen = {};
	let disk_s = [];
	for (let diskp in paths) {
		let d = disk_of(diskp);
		if (!d)
			continue;
		if (seen[d.src])
			continue;
		seen[d.src] = true;
		push(disk_s, sprintf('%s %d%%', diskp, d.pct));
		if (as_bool(cfg('alert_disk', '1'), true) && d.pct >= disk_l)
			notify('严重', '资源', '磁盘空间不足',
				sprintf('%s 已用 %d%%，阈值 %d%%（请把大日志改到 U 盘/外置盘）', diskp, d.pct, disk_l),
				'disk-' + replace(d.src, /[\/ ]/g, '_'));
	}

	let temp_l = +cfg('temp_c', 80);
	if (as_bool(cfg('alert_temp', '1'), true) && tmp >= temp_l)
		notify('中等', '资源', '温度过高',
			sprintf('当前 %d℃，阈值 %d℃', tmp, temp_l), 'temp');

	if (as_bool(cfg('log_sample', '1'), true)) {
		let ttxt = tmp > 0 ? sprintf('%d℃', tmp) : '无传感器';
		log_event('信息', '资源', '状态采样',
			sprintf('CPU %d%% · 负载 %s · 内存 %d%% · 温度 %s · 磁盘 %s · DHCP %s',
				cpu, ld, mem, ttxt,
				length(disk_s) ? join_sp(disk_s) : '无',
				length(dhcp_s) ? join_sp(dhcp_s) : '无'));
	}
}

function handle(event, iface) {
	let host = hostname();
	switch (event) {
	case 'test':
		log_event('一般', '系统', '报警测试', '已请求发送钉钉测试消息');
		if (!send_dingtalk(sprintf('[%s] 线路报警测试 %s', host, now_fmt()), true))
			exit(1);
		break;
	case 'check':
		check_metrics();
		break;
	case 'down':
		if (!as_bool(cfg('alert_down', '1'), true))
			return;
		notify('严重', '线路', '断线告警',
			sprintf('当前网口 %s 异常/掉线，请检查线路或光猫。', iface), 'down-' + iface);
		if (as_bool(cfg('alert_all_down', '1'), true) && count_up_wans() == 0)
			notify('严重', '线路', '全部 WAN 掉线',
				'所有已启用 WAN 均不可用，内网将无法上网。', 'all-down');
		break;
	case 'up':
		if (!as_bool(cfg('alert_up', '1'), true))
			return;
		notify('一般', '线路', '线路恢复',
			sprintf('网口 %s 已恢复正常。', iface), 'up-' + iface);
		break;
	case 'boot':
		log_event('一般', '系统', '系统启动', '告警服务已启动，开始监控线路与资源。');
		break;
	case 'watch':
		log_event('一般', '系统', '系统启动', '告警服务已启动，开始监控线路与资源。');
		while (true) {
			check_metrics();
			let n = +cfg('check_interval', 60);
			if (n < 30)
				n = 30;
			if (n > 3600)
				n = 3600;
			system(sprintf('sleep %d', n));
			try { ctx.unload(CONF); } catch (e) {}
			ctx.load(CONF);
		}
		break;
	default:
		exit(1);
	}
}

let event = ARGV[0];
let iface = ARGV[1] || 'unknown';
if (event == null || event == '')
	exit(1);
handle(event, iface);
exit(0);
