#!/usr/bin/ucode
'use strict';

import { cursor } from 'uci';
import { writefile } from 'fs';

function ip2n(s) {
	let p = split(`${s}`, '.');
	if (length(p) != 4)
		return null;
	return (+p[0] * 16777216) + (+p[1] * 65536) + (+p[2] * 256) + +p[3];
}

function n2ip(n) {
	return sprintf('%d.%d.%d.%d',
		int(n / 16777216) % 256,
		int(n / 65536) % 256,
		int(n / 256) % 256,
		n % 256);
}

function expand(item) {
	item = replace(`${item}`, /\s+/g, '');
	if (item == '')
		return [];
	let dash = index(item, '-');
	if (dash < 0) {
		if (ip2n(item) == null)
			return [];
		return [ item ];
	}
	let a = ip2n(substr(item, 0, dash));
	let b = ip2n(substr(item, dash + 1));
	if (a == null || b == null || b < a)
		return [];
	if (b - a > 256)
		b = a + 256;
	let out = [];
	for (let n = a; n <= b; n++)
		push(out, n2ip(n));
	return out;
}

function fake_mac(ip) {
	let n = ip2n(ip);
	if (n == null)
		return '02:00:00:00:00:00';
	return sprintf('02:00:%02x:%02x:%02x:%02x',
		int(n / 16777216) % 256,
		int(n / 65536) % 256,
		int(n / 256) % 256,
		n % 256);
}

let ctx = cursor();
ctx.load('dhcp');
let raw = ctx.get('dhcp', 'lan', 'exclude');
let items = [];
if (type(raw) == 'array')
	items = raw;
else if (raw != null && raw != '')
	items = [ raw ];

let ips = [];
let seen = {};
for (let item in items) {
	for (let ip in expand(item)) {
		if (seen[ip])
			continue;
		seen[ip] = true;
		push(ips, ip);
	}
}

system('mkdir -p /tmp/dnsmasq.d /etc/dnsmasq.d');
let lines = [ '# generated by lan-dhcp-apply; do not edit' ];
for (let ip in ips)
	push(lines, sprintf('dhcp-host=%s,%s', fake_mac(ip), ip));
let text = '';
for (let i = 0; i < length(lines); i++)
	text += lines[i] + '\n';
writefile('/tmp/dnsmasq.d/lan-exclude.conf', text);
writefile('/etc/dnsmasq.d/lan-exclude.conf', text);

if (ARGV[0] == 'reload')
	system('/etc/init.d/dnsmasq restart >/dev/null 2>&1');
exit(0);
