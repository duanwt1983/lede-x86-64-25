#!/bin/sh
# Build /etc/mosdns/config_custom.yaml from UCI (LuCI Custom Config form).
# Only runs when configfile is the custom yaml.

[ -f /lib/functions.sh ] || exit 0
. /lib/functions.sh

CONF="$(uci -q get mosdns.config.configfile)"
[ "$CONF" = "/etc/mosdns/config_custom.yaml" ] || [ -z "$CONF" ] || exit 0

OUT="/etc/mosdns/config_custom.yaml"
TMP="${OUT}.$$"

uci_get() { uci -q get "mosdns.config.$1"; }

LISTEN="$(uci_get listen_port)"
[ -n "$LISTEN" ] || LISTEN=5335
API="$(uci_get listen_port_api)"
[ -n "$API" ] || API=9091
LOG_LEVEL="$(uci_get log_level)"
[ -n "$LOG_LEVEL" ] || LOG_LEVEL=info
LOG_FILE="$(uci_get log_file)"
[ -n "$LOG_FILE" ] || LOG_FILE=/var/log/mosdns.log
CACHE_SIZE="$(uci_get cache_size)"
[ -n "$CACHE_SIZE" ] || CACHE_SIZE=20000
LAZY_TTL="$(uci_get lazy_cache_ttl)"
[ -n "$LAZY_TTL" ] || LAZY_TTL=86400
STATS_CAP="$(uci_get stats_capacity)"
[ -n "$STATS_CAP" ] || STATS_CAP=2000
STATS_INT="$(uci_get stats_dump_interval)"
[ -n "$STATS_INT" ] || STATS_INT=600
DUMP_INT="$(uci_get dump_interval)"
[ -n "$DUMP_INT" ] || DUMP_INT=600
IDLE_DEF=5
BOUND_MS="$(uci_get custom_bound_ms)"
[ -n "$BOUND_MS" ] || BOUND_MS=200
SYS_MS="$(uci_get custom_sys_ms)"
[ -n "$SYS_MS" ] || SYS_MS=250
ROL_MS="$(uci_get custom_remote_or_local_ms)"
[ -n "$ROL_MS" ] || ROL_MS=400

PREFER=0
config_load mosdns
config_get_bool PREFER config prefer_ipv4 1
[ "$PREFER" = 1 ] || PREFER=0

WAN_N=0
LOCAL_TAGS=""
REMOTE_TAGS=""
ALL_LOCAL=""
ALL_REMOTE=""

l3_of() {
	ubus call "network.interface.$1" status 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null | head -n 1
}

append_unique() {
	local hay="$1" needle="$2"
	case " $hay " in
		*" $needle "*) printf '%s' "$hay" ;;
		*) printf '%s' "$hay $needle" ;;
	esac
}

emit_upstreams() {
	local bind="$1"
	local idle="$2"
	shift 2
	local a
	for a in "$@"; do
		[ -n "$a" ] || continue
		printf '        - addr: "%s"\n' "$a"
		[ -n "$bind" ] && printf '          bind_to_device: "%s"\n' "$bind"
		printf '          idle_timeout: %s\n' "$idle"
	done
}

emit_forward() {
	local tag="$1"
	local bind="$2"
	local idle="$3"
	shift 3
	printf '  - tag: %s\n' "$tag"
	printf '    type: forward\n'
	printf '    args:\n'
	printf '      concurrent: 1\n'
	printf '      upstreams:\n'
	emit_upstreams "$bind" "$idle" "$@"
	printf '\n'
}

emit_fallback() {
	local dest="$1"
	shift
	printf '  - tag: %s\n' "$1" >>"$dest"
	printf '    type: fallback\n' >>"$dest"
	printf '    args:\n' >>"$dest"
	printf '      primary: %s\n' "$2" >>"$dest"
	printf '      secondary: %s\n' "$3" >>"$dest"
	printf '      threshold: %s\n' "$4" >>"$dest"
	printf '      always_standby: true\n\n' >>"$dest"
}

scan_wan() {
	local sid="$1"
	local net bind idle l3
	local locals remotes

	config_get net "$sid" network
	[ -n "$net" ] || return 0
	config_get_bool bind "$sid" bind_device 1
	config_get idle "$sid" idle_timeout "$IDLE_DEF"
	[ -n "$idle" ] || idle=$IDLE_DEF

	locals="$(uci -q get "mosdns.${sid}.local_dns")"
	remotes="$(uci -q get "mosdns.${sid}.remote_dns")"
	# list options: uci get returns space-separated
	[ -n "$locals" ] || locals="223.5.5.5"
	[ -n "$remotes" ] || remotes="8.8.8.8"

	l3=""
	if [ "$bind" = 1 ]; then
		l3="$(l3_of "$net")"
	fi

	WAN_N=$((WAN_N + 1))
	LOCAL_TAGS="$LOCAL_TAGS fw_l${WAN_N}"
	REMOTE_TAGS="$REMOTE_TAGS fw_r${WAN_N}"

	# stash for later emit via files (ash has no arrays)
	printf '%s\n' "$l3" >"/tmp/mosdns-bind-$WAN_N"
	printf '%s\n' "$idle" >"/tmp/mosdns-idle-$WAN_N"
	printf '%s\n' "$locals" >"/tmp/mosdns-local-$WAN_N"
	printf '%s\n' "$remotes" >"/tmp/mosdns-remote-$WAN_N"

	local a
	for a in $locals; do
		ALL_LOCAL="$(append_unique "$ALL_LOCAL" "$a")"
	done
	for a in $remotes; do
		ALL_REMOTE="$(append_unique "$ALL_REMOTE" "$a")"
	done
}

fold() {
	local fb="$1"
	local prefix="$2"
	local sys="$3"
	local ms_bound="$4"
	local ms_sys="$5"
	shift 5
	local acc i new

	if [ -z "$1" ]; then
		echo "$sys"
		return 0
	fi
	if [ -z "$2" ]; then
		emit_fallback "$fb" "${prefix}_fail" "$1" "$sys" "$ms_sys"
		echo "${prefix}_fail"
		return 0
	fi
	acc=$1
	shift
	i=0
	while [ -n "$1" ]; do
		i=$((i + 1))
		new="${prefix}_b${i}"
		emit_fallback "$fb" "$new" "$acc" "$1" "$ms_bound"
		acc=$new
		shift
	done
	emit_fallback "$fb" "${prefix}_fail" "$acc" "$sys" "$ms_sys"
	echo "${prefix}_fail"
}

FB="/tmp/mosdns-fb.$$"
: >"$FB"

{
	printf 'log:\n  level: %s\n  file: "%s"\n\n' "$LOG_LEVEL" "$LOG_FILE"
	printf 'api:\n  http: "0.0.0.0:%s"\n\n' "$API"
	printf 'include: []\n\nplugins:\n'
	printf '  - tag: stats_collector\n    type: stats_api\n    args:\n      capacity: %s\n      dump_file: "/etc/mosdns/stats.dump"\n      dump_interval: %s\n\n' "$STATS_CAP" "$STATS_INT"
	cat <<'EOF'
  - tag: geosite_cn
    type: domain_set
    args:
      files:
        - "/var/mosdns/geosite_cn.txt"

  - tag: geoip_cn
    type: ip_set
    args:
      files:
        - "/var/mosdns/geoip_cn.txt"

  - tag: geosite_no_cn
    type: domain_set
    args:
      files:
        - "/var/mosdns/geosite_geolocation-!cn.txt"

  - tag: whitelist
    type: domain_set
    args:
      files:
        - "/etc/mosdns/rule/whitelist.txt"

EOF
	printf '  - tag: lazy_cache\n    type: cache\n    args:\n      size: %s\n      lazy_cache_ttl: %s\n      dump_file: "/etc/mosdns/cache.dump"\n      dump_interval: %s\n\n' "$CACHE_SIZE" "$LAZY_TTL" "$DUMP_INT"

	config_load mosdns
	config_foreach scan_wan wan

	i=1
	while [ "$i" -le "$WAN_N" ]; do
		bind="$(cat /tmp/mosdns-bind-$i 2>/dev/null)"
		idle="$(cat /tmp/mosdns-idle-$i 2>/dev/null)"
		locals="$(cat /tmp/mosdns-local-$i 2>/dev/null)"
		remotes="$(cat /tmp/mosdns-remote-$i 2>/dev/null)"
		emit_forward "fw_l${i}" "$bind" "$idle" $locals
		emit_forward "fw_r${i}" "$bind" "$idle" $remotes
		i=$((i + 1))
	done

	[ -n "$ALL_LOCAL" ] || ALL_LOCAL="223.5.5.5"
	[ -n "$ALL_REMOTE" ] || ALL_REMOTE="8.8.8.8 1.1.1.1"
	emit_forward forward_sys_local "" "$IDLE_DEF" $ALL_LOCAL
	emit_forward forward_sys_remote "" "$IDLE_DEF" $ALL_REMOTE

	LOCAL_ENTRY="$(fold "$FB" dns_l forward_sys_local "$BOUND_MS" "$SYS_MS" $LOCAL_TAGS)"
	REMOTE_ENTRY="$(fold "$FB" dns_r forward_sys_remote "$BOUND_MS" "$SYS_MS" $REMOTE_TAGS)"
	cat "$FB"

	if [ "$PREFER" = 1 ]; then
		printf '  - tag: local_sequence\n    type: sequence\n    args:\n      - exec: prefer_ipv4\n      - exec: $%s\n\n' "$LOCAL_ENTRY"
		printf '  - tag: remote_sequence\n    type: sequence\n    args:\n      - exec: prefer_ipv4\n      - exec: $%s\n\n' "$REMOTE_ENTRY"
	else
		printf '  - tag: local_sequence\n    type: sequence\n    args:\n      - exec: $%s\n\n' "$LOCAL_ENTRY"
		printf '  - tag: remote_sequence\n    type: sequence\n    args:\n      - exec: $%s\n\n' "$REMOTE_ENTRY"
	fi

	printf '  - tag: remote_or_local\n    type: fallback\n    args:\n      primary: remote_sequence\n      secondary: local_sequence\n      threshold: %s\n      always_standby: true\n\n' "$ROL_MS"

	cat <<'EOF'
  - tag: query_is_whitelist
    type: sequence
    args:
      - matches: qname $whitelist
        exec: $local_sequence

  - tag: has_resp_sequence
    type: sequence
    args:
      - matches: has_resp
        exec: accept

  - tag: query_is_local_ip
    type: sequence
    args:
      - exec: $local_sequence
      - matches: "!resp_ip $geoip_cn"
        exec: drop_resp

  - tag: query_is_remote
    type: sequence
    args:
      - exec: $remote_or_local

  - tag: fallback
    type: fallback
    args:
      primary: query_is_local_ip
      secondary: query_is_remote
      threshold: 500
      always_standby: true

  - tag: query_is_local_domain
    type: sequence
    args:
      - matches: qname $geosite_cn
        exec: $local_sequence

  - tag: query_is_no_local_domain
    type: sequence
    args:
      - matches: qname $geosite_no_cn
        exec: $remote_or_local

  - tag: main_sequence
    type: sequence
    args:
      - exec: $stats_collector
      - exec: $lazy_cache
      - exec: jump has_resp_sequence
      - exec: $query_is_whitelist
      - exec: jump has_resp_sequence
      - exec: $query_is_local_domain
      - exec: jump has_resp_sequence
      - exec: $query_is_no_local_domain
      - exec: jump has_resp_sequence
      - exec: $fallback

EOF
	printf '  - tag: udp_server\n    type: udp_server\n    args:\n      entry: main_sequence\n      listen: ":%s"\n\n' "$LISTEN"
	printf '  - tag: tcp_server\n    type: tcp_server\n    args:\n      entry: main_sequence\n      listen: ":%s"\n' "$LISTEN"
} >"$TMP"

i=1
while [ "$i" -le "$WAN_N" ]; do
	rm -f "/tmp/mosdns-bind-$i" "/tmp/mosdns-idle-$i" "/tmp/mosdns-local-$i" "/tmp/mosdns-remote-$i"
	i=$((i + 1))
done
rm -f "$FB"

mv -f "$TMP" "$OUT"
logger -t mosdns-gen "wrote $OUT ($WAN_N WAN paths, listen $LISTEN api $API)"
exit 0
