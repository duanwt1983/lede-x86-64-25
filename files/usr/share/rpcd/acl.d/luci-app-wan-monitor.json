{
	"luci-app-wan-monitor": {
		"description": "Grant access to WAN monitor, system alerts and log center",
		"read": {
			"ubus": {
				"wanmonitor": [ "snapshot" ]
			},
			"uci": [ "wanalert", "system" ],
			"file": {
				"/usr/sbin/wan-alert": [ "exec" ],
				"/usr/libexec/lede-log-read": [ "exec" ]
			}
		},
		"write": {
			"uci": [ "wanalert", "system" ],
			"file": {
				"/usr/sbin/wan-alert": [ "exec" ],
				"/usr/libexec/lede-log-read": [ "exec" ]
			}
		}
	}
}
